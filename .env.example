# Reddit API credentials from https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# Telegram bot token from BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs and/or chat IDs allowed to use the bot.
TELEGRAM_ALLOWED_IDS=

# Chat ID used by `finage digest send`.
TELEGRAM_DEFAULT_CHAT_ID=

# M1 supports Gemini first. Keep this as gemini for now.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# WSB collection defaults.
WSB_SUBREDDIT=wallstreetbets
WSB_POST_LIMIT=75
WSB_TICKER_LIMIT=10
WSB_MIN_SCORE=100
WSB_MIN_COMMENTS=10
WSB_TOP_COMMENTS=5

# Local latest-run artifacts.
FINAGE_DATA_DIR=data

# Optional: point at a custom digest prompt template for experimentation.
# Template must include {evidence_json}.
DIGEST_PROMPT_PATH=

# Optional: Exa web search (https://exa.ai) for digest enrichment.
EXA_API_KEY=
# When set, defaults to exa; leave empty to disable web search provider selection.
WEB_SEARCH_PROVIDER=
WEB_SEARCH_NUM_RESULTS=3
WEB_SEARCH_CONTENT_MODE=highlights
WEB_SEARCH_TIMEOUT_SECONDS=15
# When unset, defaults to enabled if EXA_API_KEY is set (see app settings).
DIGEST_WEB_SEARCH_ENABLED=
